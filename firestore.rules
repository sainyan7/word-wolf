rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{code} {

      function roomData() {
        return get(/databases/$(database)/documents/rooms/$(code)).data;
      }
      function isHost() {
        return roomData().hostUid == request.auth.uid;
      }
      function seatClaimedByMe(seat) {
        return get(/databases/$(database)/documents/rooms/$(code)/seats/$(seat)).data.claimedBy == request.auth.uid;
      }

      // 部屋本体: 議題などの秘密は含まない（フェーズ・タイマー・人数のみ）
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // 座席: 名前と着席状況のみ（秘密なし）。着席は空席への claimedBy 設定だけ許可
      match /seats/{seat} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && isHost();
        allow update: if request.auth != null && (
          isHost()
          || ((!resource.data.keys().hasAny(['claimedBy']) || resource.data.claimedBy == null)
              && request.resource.data.claimedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']))
          || (resource.data.claimedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewed']))
        );
      }

      // 議題: 自分の席のものだけ読める。真相公開フェーズは全員読める
      match /words/{seat} {
        allow get: if request.auth != null && (
          isHost() || roomData().phase == 'result' || seatClaimedByMe(seat)
        );
        allow list: if request.auth != null && (isHost() || roomData().phase == 'result');
        allow create, update, delete: if request.auth != null && isHost();
      }

      // 役割（造反者/スパイか）: 真相公開まで本人にも見せない
      match /roles/{seat} {
        allow get, list: if request.auth != null && (isHost() || roomData().phase == 'result');
        allow create, update, delete: if request.auth != null && isHost();
      }
    }
  }
}
